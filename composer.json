{
	"name": "cosellhive/cosell-hive",
	"description": "CoSellHive — shared affiliate marketplace connector for WooCommerce.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.7",
		"wp-coding-standards/wpcs": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpcsstandards/phpcsextra": "^1.2"
	},
	"autoload": {
		"psr-4": {
			"CoSellHive\\": "includes/",
			"CoSellHive\\Modules\\": "modules/"
		},
		"files": [
			"includes/functions-helpers.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"CoSellHive\\Tests\\": "tests/php/"
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
